# Copy to .env.local for local development. NEVER commit real secrets.
# Only the PUBLIC anon key belongs here. Never put the service_role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: public site URL used for canonical links, sitemap and hreflang (with trailing slash).
# On GitHub Actions this is derived automatically; set it for a custom domain.
SITE_URL=https://YOUR-USER.github.io/dalilak/

# Optional: path the site is served from. "/" for user pages or custom domain, "/dalilak/" for project pages.
BASE_PATH=/

# Optional: set to "true" to enable Google sign-in button (configure the provider in Supabase first).
VITE_GOOGLE_AUTH=false

# Optional: contact email shown on the Contact page.
VITE_CONTACT_EMAIL=hello@example.com
